# Asal API dokumentasi (dibaca di server saat build/revalidasi).
API_ORIGIN=https://api-staging.postmatic.id

# URL publik situs docs: dipakai untuk canonical, sitemap, Open Graph, llms.txt.
NEXT_PUBLIC_SITE_URL=https://docs.postmatic.id

# Opsional. Default mengikuti landing page.
# NEXT_PUBLIC_LANDINGPAGE_URL=https://postmatic.id
# NEXT_PUBLIC_DASHBOARD_URL=https://workspace.postmatic.id
# NEXT_PUBLIC_LOGIN_URL=https://auth.postmatic.id/login?from=https%3A%2F%2Fworkspace.postmatic.id

# Indeks mesin pencari otomatis aktif hanya di VERCEL_ENV=production.
# Paksa dengan true/false bila perlu (mis. untuk audit Lighthouse lokal).
# ALLOW_INDEXING=false

